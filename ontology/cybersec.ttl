    cs:targetsVulnerability ex:Vuln_WeakPassword ;
    cs:affectsSystem ex:Sys_WebServer ;
    cs:mitigatedBy ex:Mit_MFA .

# SECURITY EVENT INSTANCES

ex:E001 a cs:SecurityEvent ;
    cs:hasIndicator ex:IOC_SuspiciousLogin ;
    cs:originatesFromIP ex:IP_45_33_32_156 ;
    cs:attemptCount "5000"^^xsd:integer ;
    cs:confidenceScore "0.92"^^xsd:float .

ex:E002 a cs:SecurityEvent ;
    cs:hasIndicator ex:IOC_MaliciousURL ;
    cs:originatesFromIP ex:IP_203_0_113_5 ;
    cs:confidenceScore "0.88"^^xsd:float .

ex:E003 a cs:SecurityEvent ;
    cs:hasIndicator ex:IOC_UnusualTraffic ;
    cs:originatesFromIP ex:IP_198_51_100_0 ;
    cs:confidenceScore "0.85"^^xsd:float .
    
# Related-to connections
ex:T001 cs:relatedTo ex:T012 .
ex:T002 cs:relatedTo ex:T008 .
ex:T002 cs:relatedTo ex:T013 .
ex:T003 cs:relatedTo ex:T011 .
ex:T003 cs:relatedTo ex:T020 .
ex:T004 cs:relatedTo ex:T014 .
ex:T006 cs:relatedTo ex:T015 .
ex:T007 cs:relatedTo ex:T016 .
ex:T009 cs:relatedTo ex:T018 .

