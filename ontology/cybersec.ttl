    cs:targetsVulnerability ex:Vuln_WeakPassword ;
    cs:affectsSystem ex:Sys_Workstation1 ;
    cs:mitigatedBy ex:Mit_AV, ex:Mit_EmailFilter .

ex:T017 a cs:DDoSAttack ;
