    cs:affectsSystem ex:Sys_Workstation1 ;
    cs:mitigatedBy ex:Mit_Patching, ex:Mit_MFA .

ex:T020 a cs:BruteForceAttack ;
    rdfs:label "FTP Credential Stuffing" ;
    cs:description "Credential stuffing attack against FTP server" ;
