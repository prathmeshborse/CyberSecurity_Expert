    cs:targetsVulnerability ex:Vuln_OpenPort ;
    cs:affectsSystem ex:Sys_Firewall ;
    cs:mitigatedBy ex:Mit_Encryption, ex:Mit_IDS .

ex:T019 a cs:Spyware ;
    rdfs:label "Pegasus-like Spyware" ;
