    cs:targetsVulnerability ex:Vuln_OutdatedSSL ;
    cs:affectsSystem ex:Sys_WebServer ;
    cs:mitigatedBy ex:Mit_Encryption .

ex:T010 a cs:Spyware ;
    rdfs:label "Keylogger Spyware" ;
    cs:description "Keylogger capturing credentials and sensitive data" ;
    cs:severityScore "7.2"^^xsd:float ;
    cs:targetsVulnerability ex:Vuln_WeakPassword ;
    cs:affectsSystem ex:Sys_Workstation1 ;
    cs:mitigatedBy ex:Mit_AV, ex:Mit_MFA .

ex:T011 a cs:BruteForceAttack ;
    rdfs:label "RDP Brute Force" ;
